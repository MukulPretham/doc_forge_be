# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URL=

# Security
APP_SECRET=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback

# LLM providers (only providers with a key set will be exposed to the UI)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Google Gemini (default)
GEMINI_API_KEY=
